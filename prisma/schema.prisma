// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        Int      @id @default(autoincrement())

  name      String

  phone     String?

  address   String?

  category  String?

  question  String

  file      String?

  answer    String?

  status    String   @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Produk {
  id          Int       @id @default(autoincrement())

  badge       String?

  title       String

  subtitle    String?

  description String    @db.LongText

  highlights  Json?

  cover       String?

  filePath    String?

  buttonText  String?   @default("Unduh File")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}